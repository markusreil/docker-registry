# Global: shared cluster configuration
# Domain used to derive all vhost names (e.g. registry.<BASE_DOMAIN>).
# Default is localhost for local testing (always resolves via DNS, no setup needed).
BASE_DOMAIN=localhost
# Docker network owned by the proxy cluster (created there first).
NGINX_PROXY_NETWORK=web-proxy
# Compose file list. Local default uses only the base file; NFS deployments use
# docker-compose.yml:docker-compose.nfs.yml (see the --- nfs --- section).
COMPOSE_FILE=docker-compose.yml

# --- registry ---
# Upstream registry image tag.
REGISTRY_VERSION=2
# Self-signed TLS opt-in (LAN variant). Defaults to true per this deployment.
REGISTRY_GEN_SELF_SIGNED_CERT=true
# Per-service proxy upload limit (client_max_body_size, nginx size syntax).
# 0 = unlimited: pushes carry arbitrarily large layers. Overridden per host
# only for this service; the proxy default applies everywhere else.
REGISTRY_NGINX_MAX_BODY_SIZE=0
# Allow the registry API to delete manifests (required for UI deletes).
REGISTRY_STORAGE_DELETE_ENABLED=false

# --- registry-ui ---
# Upstream joxit/docker-registry-ui image tag.
REGISTRY_UI_VERSION=latest
# Title shown in the UI header.
REGISTRY_UI_TITLE=Docker Registry UI
# Allow deleting images from the UI (registry must enable deletes separately).
REGISTRY_UI_DELETE_IMAGES=false
# Show content digest column in the UI.
REGISTRY_UI_SHOW_DIGEST=true
# Self-signed TLS opt-in (LAN variant). Defaults to true per this deployment.
REGISTRY_UI_GEN_SELF_SIGNED_CERT=true

# --- nfs ---
# Only used when COMPOSE_FILE includes docker-compose.nfs.yml.
# NFS export path, e.g. :/exports/registry.
NFS_DEVICE=:/exports/registry
# NFS mount options, e.g. addr=10.0.0.5,rw,nfsvers=4.
NFS_OPTS=addr=10.0.0.5,rw,nfsvers=4
